<resources>
    <style name="Theme.OceanProfessional" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/ocean_background</item>
        <item name="android:textColor">@color/ocean_text</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Material colors -->
        <item name="colorPrimary">@color/ocean_primary</item>
        <item name="colorPrimaryVariant">@color/ocean_primary_variant</item>
        <item name="colorSecondary">@color/ocean_secondary</item>
        <item name="colorError">@color/ocean_error</item>

        <item name="materialButtonStyle">@style/Ocean.Button</item>
        <item name="cardViewStyle">@style/Ocean.Card</item>
    </style>

    <style name="Ocean.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardUseCompatPadding">true</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">@color/ocean_surface</item>
        <item name="cardElevation">6dp</item>
    </style>

    <style name="Ocean.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/ocean_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="elevation">2dp</item>
    </style>

    <style name="Ocean.Text.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ocean_text</item>
    </style>

    <style name="Ocean.Text.Status" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/ocean_text</item>
    </style>

    <style name="Ocean.Tile">
        <item name="android:background">@drawable/bg_tile</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/ocean_text</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">72dp</item>
    </style>
</resources>
